#
# Project-local xschemrc for CPLZ-LS01 (bidirectional 1.2 V <-> 3.3 V level shifter).
#
# Deliberately NOT a symlink to, or a copy of, the PDK's own xschemrc: absolute
# PDK paths are not portable between machines/containers.  Instead this file
# resolves the PDK through $PDK_ROOT/$PDK and sources the PDK's xschemrc, then
# appends only this project's own library paths.  Same pattern as
# sky130_ef_ip__template/xschem/xschemrc.
#
# xschem only reads the xschemrc in the directory it is started from, so
# launch it from the repo root (or pass --rcfile pointing here).
#

# ---------------------------------------------------------------- PDK_ROOT --
# Honour the environment first; only guess if it is unset.
if { ![info exists env(PDK_ROOT)] || $env(PDK_ROOT) eq "" } {
    puts stderr "xschemrc: PDK_ROOT not set, looking for an open_pdks install"
    foreach candidate [list \
            /foss/pdks \
            /usr/share/pdk \
            /usr/local/share/pdk \
            $env(HOME)/share/pdk \
            $env(HOME)/.ciel \
            $env(HOME)/.volare ] {
        if { [file isdirectory $candidate/ihp-sg13cmos5l] ||
             [file isdirectory $candidate/ihp-sg13g2] } {
            set ::env(PDK_ROOT) $candidate
            break
        }
    }
}
if { ![info exists env(PDK_ROOT)] } {
    puts stderr "xschemrc: no open_pdks installation found."
    puts stderr "          Set PDK_ROOT (and PDK) and restart xschem."
}

# --------------------------------------------------------------------- PDK --
# The schematics use sg13cmos5l_pr/ device symbols, which only ihp-sg13cmos5l
# ships (ihp-sg13g2 has sg13g2_pr/ only).  IIC-OSIC-TOOLS exports PDK=ihp-sg13g2
# by default, so an inherited PDK is kept only if it provides sg13cmos5l_pr/;
# otherwise switch to ihp-sg13cmos5l when it is installed.
if { ![info exists env(PDK)] } { set ::env(PDK) "" }
if { [info exists env(PDK_ROOT)] &&
     ![file isdirectory $env(PDK_ROOT)/$env(PDK)/libs.tech/xschem/sg13cmos5l_pr] &&
     [file isdirectory $env(PDK_ROOT)/ihp-sg13cmos5l] } {
    if { $env(PDK) ne "" } {
        puts stderr "xschemrc: PDK=$env(PDK) has no sg13cmos5l_pr symbols, using ihp-sg13cmos5l"
    }
    set ::env(PDK) ihp-sg13cmos5l
}
if { $env(PDK) eq "" } { set ::env(PDK) ihp-sg13cmos5l }

# ------------------------------------------------- source the PDK xschemrc --
# This is what sets XSCHEM_LIBRARY_PATH to the PDK device symbols, the netlist
# format, the tech-specific menus, etc.  Everything below only adds to it.
if { [info exists env(PDK_ROOT)] } {
    set pdk_xschemrc $env(PDK_ROOT)/$env(PDK)/libs.tech/xschem/xschemrc
    if { [file exists $pdk_xschemrc] } {
        source $pdk_xschemrc
    } else {
        puts stderr "xschemrc: $pdk_xschemrc not found -- PDK symbols will be missing."
    }
}

# --------------------------------------------------- project library paths --
# Resolved from this file's own location, so they are correct no matter which
# directory xschem was started from.
set project_xschem_dir [file join [file dirname [file normalize [info script]]] xschem]

# Project cell library: xschem/logic_gates (INVLV, NANDHV, SCHMLV, ...) and
# xschem/schematics (bidir_channel, level_shifter_up, dff_c2mos, ...).
# Instances reference them as <folder>/<cell>.sym.
append XSCHEM_LIBRARY_PATH :$project_xschem_dir

# Device symbols (sg13cmos5l_pr/sg13_{lv,hv}_{n,p}mos.sym) come from the PDK's
# own library, which the PDK xschemrc above puts on the path.  There are no
# local copies: without a PDK install the schematics will show missing symbols.
set found_pr 0
foreach dir [split $XSCHEM_LIBRARY_PATH :] {
    if { [file isdirectory $dir/sg13cmos5l_pr] } { set found_pr 1; break }
}
if { !$found_pr } {
    puts stderr "xschemrc: no sg13cmos5l_pr/ symbol library on XSCHEM_LIBRARY_PATH"
    puts stderr "          (PDK_ROOT=[expr {[info exists env(PDK_ROOT)] ? $env(PDK_ROOT) : {unset}}]\
                  PDK=$env(PDK)) -- MOS symbols will be missing."
}

# ------------------------------------------------------------- conveniences --
# Netlists and simulation output go to xschem/simulation/ (git-ignored), not
# into a scratch directory under $HOME.
set netlist_dir [file normalize $project_xschem_dir/simulation]
file mkdir $netlist_dir
