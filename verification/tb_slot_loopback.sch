C {devices/lab_pin.sym} -140 -20 0 0 {name=l13 sig_type=std_logic lab=d1}
C {devices/lab_pin.sym} -140 0 0 0 {name=l14 sig_type=std_logic lab=d2}
C {devices/lab_pin.sym} -140 20 0 0 {name=l15 sig_type=std_logic lab=d3}
C {devices/lab_pin.sym} -140 40 0 0 {name=l16 sig_type=std_logic lab=0}
C {devices/lab_pin.sym} -140 60 0 0 {name=l17 sig_type=std_logic lab=0}
C {devices/lab_pin.sym} -140 80 0 0 {name=l18 sig_type=std_logic lab=0}
