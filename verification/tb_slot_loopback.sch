C {devices/lab_pin.sym} -140 200 0 0 {name=l24 sig_type=std_logic lab=0}
C {devices/lab_pin.sym} -140 220 0 0 {name=l25 sig_type=std_logic lab=0}
C {devices/lab_pin.sym} -140 240 0 0 {name=l26 sig_type=std_logic lab=0}
C {devices/lab_pin.sym} -140 260 0 0 {name=l27 sig_type=std_logic lab=0}
C {devices/lab_pin.sym} 140 -260 0 1 {name=l28 sig_type=std_logic lab=q0}
C {devices/lab_pin.sym} 140 -240 0 1 {name=l29 sig_type=std_logic lab=q1}
C {devices/lab_pin.sym} 140 -220 0 1 {name=l30 sig_type=std_logic lab=q2}
C {devices/lab_pin.sym} 140 -200 0 1 {name=l31 sig_type=std_logic lab=q3}
C {devices/lab_pin.sym} 140 -180 0 1 {name=l32 sig_type=std_logic lab=q4}
C {devices/lab_pin.sym} 140 -160 0 1 {name=l33 sig_type=std_logic lab=q5}
C {devices/lab_pin.sym} 140 -140 0 1 {name=l34 sig_type=std_logic lab=q6}
C {devices/lab_pin.sym} 140 -120 0 1 {name=l35 sig_type=std_logic lab=q7}
C {devices/lab_pin.sym} 140 -100 0 1 {name=l36 sig_type=std_logic lab=q8}
C {devices/lab_pin.sym} 140 -80 0 1 {name=l37 sig_type=std_logic lab=q9}
C {devices/lab_pin.sym} 140 -60 0 1 {name=l38 sig_type=std_logic lab=q10}
C {devices/lab_pin.sym} 140 -40 0 1 {name=l39 sig_type=std_logic lab=q11}
C {devices/lab_pin.sym} 140 -20 0 1 {name=l40 sig_type=std_logic lab=a0}
C {devices/lab_pin.sym} 140 0 0 1 {name=l41 sig_type=std_logic lab=b0}
C {devices/lab_pin.sym} 140 20 0 1 {name=l42 sig_type=std_logic lab=0}
C {devices/lab_pin.sym} 140 40 0 1 {name=l43 sig_type=std_logic lab=0}
C {devices/lab_pin.sym} 140 60 0 1 {name=l44 sig_type=std_logic lab=0}
C {devices/lab_pin.sym} 140 80 0 1 {name=l45 sig_type=std_logic lab=0}
C {devices/lab_pin.sym} 140 100 0 1 {name=l46 sig_type=std_logic lab=0}
C {devices/lab_pin.sym} 140 120 0 1 {name=l47 sig_type=std_logic lab=0}
C {devices/lab_pin.sym} 140 140 0 1 {name=l48 sig_type=std_logic lab=0}
C {devices/lab_pin.sym} 140 160 0 1 {name=l49 sig_type=std_logic lab=0}
C {devices/lab_pin.sym} -40 -310 0 0 {name=l50 sig_type=std_logic lab=vddl}
C {devices/lab_pin.sym} 40 -310 0 1 {name=l51 sig_type=std_logic lab=vddh}
C {devices/lab_pin.sym} -40 310 0 0 {name=l52 sig_type=std_logic lab=0}
C {devices/lab_pin.sym} 40 310 0 1 {name=l53 sig_type=std_logic lab=0}
T {slot_1: dig_in -> channel 1 -> shared 3.3 V bus -> channel 2 -> dig_out, then the other way} -400 -420 0 0 0.8 0.8 {}
C {devices/code_shown.sym} -900 -250 0 0 {name=SIM only_toplevel=false value=".lib cornerMOSlv.lib mos_tt
.lib cornerMOShv.lib mos_tt
.lib cornerRES.lib res_typ
VDL vddl 0 1.2
VDH vddh 0 3.3
Ven enable 0 PWL(0 0 3n 0 3.5n 1.2)
Voe oe_n 0 0
* 0-500 ns: channel 1 copies A to B, channels 2 and 3 copy B to A.
* 500 ns on: channel 2 copies A to B, channels 1 and 3 copy B to A.
Vdir1 dir1 0 PWL(0 0 500n 0 501n 1.2)
Vdir2 dir2 0 PWL(0 1.2 500n 1.2 501n 0)
Vdir3 dir3 0 1.2
Vdir0 dir0 0 0
* dig_in data for channels 1 and 2 (20 MHz); channel 0 on its pads (25 MHz)
Vd1 d1 0 PULSE(0 1.2 50n 0.5n 0.5n 24.5n 50n)
Vd2 d2 0 PULSE(0 1.2 550n 0.5n 0.5n 24.5n 50n)
Vd3 d3 0 0
Va0 a0src 0 PULSE(0 1.2 50n 0.3n 0.3n 19.7n 40n)
Ra0 a0src a0 50
CB0 b0 0 5p
.control
save all
tran 50p 1u
* delays from the first dig_in edge after everything has settled
meas tran t_12r trig v(d1) val=0.6 rise=1 td=140n targ v(q9) val=0.6 rise=1 td=140n
meas tran t_12f trig v(d1) val=0.6 fall=1 td=140n targ v(q9) val=0.6 fall=1 td=140n
meas tran t_13r trig v(d1) val=0.6 rise=1 td=140n targ v(q10) val=0.6 rise=1 td=140n
meas tran t_21r trig v(d2) val=0.6 rise=1 td=640n targ v(q8) val=0.6 rise=1 td=640n
meas tran t_21f trig v(d2) val=0.6 fall=1 td=640n targ v(q8) val=0.6 fall=1 td=640n
meas tran t_pad trig v(a0) val=0.6 rise=3 targ v(b0) val=1.65 rise=3
meas tran bus_max max xdut.b_bus from=140n to=500n
meas tran en_out find v(q11) at=400n
write tb_slot_loopback.raw
.endc"}
