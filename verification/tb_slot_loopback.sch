E {}
C {schematics/slot_1.sym} 0 0 0 0 {name=XDUT}
C {devices/lab_pin.sym} -140 -260 0 0 {name=l1 sig_type=std_logic lab=enable}
C {devices/lab_pin.sym} -140 -240 0 0 {name=l2 sig_type=std_logic lab=0}
C {devices/lab_pin.sym} -140 -220 0 0 {name=l3 sig_type=std_logic lab=0}
