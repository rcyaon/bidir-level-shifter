# --- OS / editor cruft -------------------------------------------------------
.DS_Store
*~
*.swp

# --- xschem ------------------------------------------------------------------
# Backups and lockfiles xschem writes next to the sources.  The .sch/.sym files
# themselves ARE tracked: they are plain ASCII and diff cleanly.
*.sch.bak
*.sym.bak
*.sch.lock
*.sym.lock
xschem/simulation/

# Netlists xschem generates from the schematics (regenerate with
#   xschem -x -n -q -o . ../xschem/cplz_ls01/tb_channel.sch ).
# sim/cplz_ls01_dut*.spice are checked in on purpose as the frozen DUT netlists
# the committed results were produced from, so they are re-included below.
sim/*.spice
!sim/cplz_ls01_dut*.spice
!sim/models_*.spice
!sim/_stub_raw.spice

# --- ngspice -----------------------------------------------------------------
*.raw
*.out
*.log
b#*
# .res measurement summaries ARE tracked -- they are the PVT table's source.

# --- magic / klayout ---------------------------------------------------------
*.ext
*.res.ext
*.nodes
*.sim
*.al
*.lef.bak
*.gds.bak
magic_*.log

# --- netgen / LVS ------------------------------------------------------------
comp.out
*.lvs.log

# --- python ------------------------------------------------------------------
__pycache__/
*.pyc
.ipynb_checkpoints/

# --- local PDK convenience links (see README, "Reproducing this repo") -------
sim/pdk
layout/pdk
