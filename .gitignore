# --- OS / editor cruft -------------------------------------------------------
.DS_Store
*~
*.swp

# --- xschem ------------------------------------------------------------------
# Backups and lockfiles xschem writes next to the sources.  The .sch/.sym files
# themselves ARE tracked: they are plain ASCII and diff cleanly.
*.sch.bak
*.sym.bak
*.sch.lock
*.sym.lock
# Netlists and simulation output (xschemrc points netlist_dir here).
xschem/simulation/

# --- ngspice -----------------------------------------------------------------
*.raw
*.out
*.log
b#*

# --- magic / klayout ---------------------------------------------------------
*.ext
*.res.ext
*.nodes
*.sim
*.al
*.lef.bak
*.gds.bak
magic_*.log

# --- netgen / LVS ------------------------------------------------------------
comp.out
*.lvs.log

# --- python ------------------------------------------------------------------
__pycache__/
*.pyc
.ipynb_checkpoints/

# --- local PDK convenience link ----------------------------------------------
layout/pdk
